{
  "name": "overlay",
  "productName": "Overlay",
  "version": "0.2.0",
  "description": "Realtime face overlay for macOS & Windows",
  "main": ".vite/build/index.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "radikahn",
  "scripts": {
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "selftest": "electron-forge start -- --selftest",
    "start": "electron-forge start",
    "test": "npm run typecheck && npm run verify:decode",
    "typecheck": "tsc --noEmit",
    "verify:decode": "node scripts/verify-decode.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.0.0",
    "electron": "44.4.3",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
